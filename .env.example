# Database (SQLite for local dev; set a postgres:// URL + provider switch for prod — see README)
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-byte-secret"

# Discord OAuth (optional in dev — a local "Dev Login" provider is enabled
# automatically when these are unset). Create an app at
# https://discord.com/developers/applications with redirect
# http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Force-enable the dev login provider even if Discord creds are set
# (never allowed in production builds — dev login is compiled out when
# NODE_ENV=production)
DEV_LOGIN="true"

# Comma-separated Discord IDs that become role=admin on their next sign-in
# ADMIN_DISCORD_IDS="123456789012345678,234567890123456789"

# Public base URL used when minting agent websocket URLs in pair responses
# PUBLIC_BASE_URL="http://localhost:3000"

# --- Orchestrator integration (Phase 6, managed bots) -----------------------
# Point at a real orchestrator, or run the in-repo mock:  npm run mock:orch
# ORCHESTRATOR_URL="http://localhost:4010"
# Set to "1" to enable managed-bot code paths against the default URL
# ORCHESTRATOR_MOCK="1"
# Ed25519 keypair the panel signs Admin-API JWTs with (PEM; \n escapes ok).
# If unset, a dev pair is generated into .orchestrator-dev.json — the mock
# reads the same file, so local runs need zero config.
# ORCHESTRATOR_PRIVATE_KEY=""
# ORCHESTRATOR_PUBLIC_KEY=""
# Bearer token the orchestrator presents when calling
# POST /api/orchestrator/instances (also dev-file backed when unset)
# ORCHESTRATOR_SERVICE_TOKEN=""
